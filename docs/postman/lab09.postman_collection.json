              }
            ],
            "url": "{{baseUrl}}/product-service/graphql",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"query KatalogUMKM { products { id name category price stock seller } }\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Query publik tanpa API key. Membaca stok yang sama dengan REST. Gunakan Apollo Sandbox untuk eksplorasi schema."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response JSON', () => pm.response.to.be.json);",
                  "const result = pm.response.json();",
                  "pm.test('Tidak ada GraphQL errors', () => pm.expect(result.errors).to.eql(undefined));",
                  "pm.test('Tiga produk dengan stok valid', () => { pm.expect(result.data.products).to.have.lengthOf(3); result.data.products.forEach(p => { pm.expect(p.stock).to.be.at.least(0); pm.expect(p.price).to.be.a('number'); }); });"
                ]
