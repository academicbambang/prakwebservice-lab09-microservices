{
  "info": {
    "name": "Lab 09 Microservices - Bambang Herlambang",
    "description": "Praktikum individu Lab 09, Bambang Herlambang, NRP 5803024019. Collection untuk repository khusus Lab 09 https://github.com/academicbambang/prakwebservice-lab09-microservices, terpisah dari repository Lab 08. Gateway dipakai ulang dari https://github.com/academicbambang/prakwebservice-lab08-api-gateway. Catalog Service berperan sebagai product-service; nama folder catalog-service dipertahankan dari kode sumber. Jalankan alur normal pada data awal, lalu input negatif. Kelompok kegagalan WAJIB dijalankan manual: hentikan hanya katalog sebelum POST 503, biarkan Order Service dan gateway aktif, lalu hidupkan kembali katalog sebelum POST 201. Jangan jalankan seluruh collection tanpa intervensi tersebut. Semua URL mengikuti baseUrl environment lokal atau deployment; isi apiKey di environment lokal. Rate limit 20 request/10 detik/IP tetap berlaku. Screenshot harus menampilkan method, URL, status, body tanpa key. Swagger UI ada di {{baseUrl}}/docs/, OpenAPI di /openapi.json, dan Apollo Sandbox di /sandbox. Folder alat pengembang dijalankan saat kedua backend aktif. baseUrl dapat diarahkan ke URL deployment HTTPS yang sudah diverifikasi; isi apiKey sesuai lingkungan, tanpa mengekspor nilainya.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080"
    },
    {
      "key": "productId",
      "value": "prod-001"
    },
    {
      "key": "orderId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Alur normal - katalog aktif",
      "description": "Mulai dengan stok katalog awal; pesanan yang diterima harus mengurangi stok tepat dua unit.",
      "item": [
        {
          "name": "01 Daftar tiga produk",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/product-service/products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response JSON', () => pm.response.to.be.json);",
                  "pm.test('Tiga produk demo', () => pm.expect(pm.response.json().data.length).to.eql(3));"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Simpan stok sebelum pesanan",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/product-service/products/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response JSON', () => pm.response.to.be.json);",
                  "pm.collectionVariables.set('stockBefore', pm.response.json().data.stock);",
                  "pm.collectionVariables.set('priceBefore', pm.response.json().data.price);"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Buat pesanan dua kopi",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/order-service/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Bambang\",\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 2\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test('Response JSON', () => pm.response.to.be.json);",
                  "const o = pm.response.json().data;",
                  "pm.collectionVariables.set('orderId', o.id);",
                  "pm.test('Total dari katalog', () => pm.expect(o.total).to.eql(Number(pm.collectionVariables.get('priceBefore')) * 2));",
                  "pm.test('Quantity benar', () => pm.expect(o.items[0].quantity).to.eql(2));"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Stok berkurang tepat dua",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/product-service/products/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response JSON', () => pm.response.to.be.json);",
                  "pm.test('Stok berkurang dua', () => pm.expect(pm.response.json().data.stock).to.eql(Number(pm.collectionVariables.get('stockBefore')) - 2));"
                ]
              }
            }
          ]
        },
        {
          "name": "05 Daftar menyimpan pesanan sukses",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/order-service/orders"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response JSON', () => pm.response.to.be.json);",
                  "pm.test('Pesanan sukses ada', () => pm.expect(pm.response.json().data.some(o => o.id === pm.collectionVariables.get('orderId'))).to.eql(true));"
                ]
              }
            }
          ]
        }
      ]
    },
