PORT=8080
HOST=127.0.0.1
CATALOG_SERVICE_URL=http://127.0.0.1:3000
ORDER_SERVICE_URL=http://127.0.0.1:3001
# Run npm run setup to create a random local key. Never commit .env.
API_KEY=replace-with-your-own-random-key
# Optional alternative: store the SHA-256 digest, leaving API_KEY empty.
# API_KEY_SHA256=replace-with-64-hex-digits
# 0 for direct localhost access; 1 only behind exactly one trusted proxy (Render).
TRUST_PROXY=0
