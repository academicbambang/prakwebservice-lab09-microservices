    "/product-service/graphql": {
      "get": {
        "operationId": "queryGraphQLGet",
        "summary": "Query GraphQL melalui URL",
        "tags": [
          "GraphQL"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Hasil eksekusi query. Periksa errors untuk kesalahan GraphQL.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GraphQLResponse"
                },
                "example": {
                  "data": {
                    "products": [
                      {
                        "id": "prod-001",
                        "name": "Kopi Arabika Gayo",
                        "stock": 40
                      }
                    ]
                  }
                }
              },
              "application/graphql-response+json": {
                "schema": {
                  "$ref": "#/components/schemas/GraphQLResponse"
                },
                "example": {
                  "data": {
                    "products": [
                      {
                        "id": "prod-001",
                        "name": "Kopi Arabika Gayo",
                        "stock": 40
                      }
                    ]
                  }
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "502": {
            "$ref": "#/components/responses/BadGateway"
          },
          "400": {
            "description": "JSON atau parameter tidak valid, query tidak valid, atau kesalahan validasi GraphQL.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/GraphQLResponse"
                    }
                  ]
                }
              },
              "application/graphql-response+json": {
                "schema": {
                  "$ref": "#/components/schemas/GraphQLResponse"
                }
              }
            }
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "406": {
            "description": "Header Accept tidak didukung oleh GraphQL over HTTP.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GraphQLResponse"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "description": "Schema publik read-only: products(category, search) dan product(id). Apollo Sandbox tersedia di /sandbox. Schema dan query membaca stok katalog yang sama dengan REST.",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "example": "query KatalogUMKM { products { id name category price stock seller } }"
          },
          {
            "name": "operationName",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "example": "KatalogUMKM"
          },
          {
            "name": "variables",
            "in": "query",
            "description": "Object variabel GraphQL yang diserialisasi sebagai JSON.",
            "schema": {
              "type": "string"
            },
            "example": "{}"
          }
        ]
      },
      "post": {
        "operationId": "queryGraphQLPost",
        "summary": "Query GraphQL melalui JSON",
        "tags": [
          "GraphQL"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Hasil eksekusi query. Periksa errors untuk kesalahan GraphQL.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GraphQLResponse"
