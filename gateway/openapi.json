              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GraphQLResponse"
                }
              }
            }
          },
          "415": {
            "description": "Content-Type tidak didukung; gunakan application/json.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GraphQLResponse"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "description": "Tidak memerlukan API key karena schema hanya menawarkan query katalog. Introspection tersedia untuk Apollo Sandbox. Tetap memakai kuota API gateway.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GraphQLRequest"
              },
              "example": {
                "query": "query KatalogUMKM { products { id name category price stock seller } }"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Isi key lokal dari gateway/.env. Nilainya tidak ditanam dalam halaman dan tidak diteruskan ke backend."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "service"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ]
          },
          "service": {
            "type": "string",
            "enum": [
              "gateway",
              "catalog-service",
              "order-service"
            ]
          }
        }
      },
      "Product": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "price",
          "stock",
          "seller"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "prod-001",
            "description": "Spasi awal/akhir dihapus; hasilnya harus 1-100 karakter."
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string"
          },
          "price": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Harga rupiah bulat."
          },
          "stock": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Stok saat ini, kembali ke seed saat service dimulai ulang."
          },
          "seller": {
            "type": "string"
          }
        },
        "example": {
          "id": "prod-001",
          "name": "Kopi Arabika Gayo",
          "category": "kuliner",
          "price": 85000,
          "stock": 40,
          "seller": "Koperasi Kopi Gayo"
        }
      },
      "ProductResponse": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Product"
          }
        }
      },
      "ProductList": {
        "type": "object",
        "required": [
          "service",
          "data"
        ],
        "properties": {
          "service": {
            "type": "string",
            "enum": [
              "catalog-service"
            ]
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Product"
            }
          }
        }
      },
      "ReserveInput": {
        "type": "object",
        "required": [
          "qty"
        ],
        "properties": {
          "qty": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "example": 2
          }
        }
      },
      "ReservationItem": {
        "type": "object",
        "required": [
          "productId",
          "quantity"
        ],
        "properties": {
          "productId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "prod-001",
            "description": "Spasi awal/akhir dihapus; hasilnya harus 1-100 karakter."
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        }
      },
      "BatchReservationInput": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/ReservationItem"
            }
          }
        },
        "description": "ID produk duplikat dijumlahkan. Seluruh batch divalidasi sebelum stok apa pun dikurangi."
      },
      "BatchReservationResponse": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Product"
            }
          }
        }
      },
      "OrderItemInput": {
        "type": "object",
        "required": [
          "productId",
          "quantity"
        ],
        "properties": {
          "productId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "prod-001",
            "description": "Spasi awal/akhir dihapus; hasilnya harus 1-100 karakter."
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "example": 2
          }
        }
      },
      "OrderInput": {
        "type": "object",
        "required": [
          "customerName",
          "items"
        ],
        "properties": {
          "customerName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Spasi awal/akhir dihapus; nama tidak boleh kosong."
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/OrderItemInput"
            }
          }
        },
        "description": "Harga/total dari klien diabaikan. ID produk duplikat dijumlahkan saat reservasi.",
        "example": {
          "customerName": "Bambang",
          "items": [
            {
              "productId": "prod-001",
              "quantity": 2
            }
          ]
        }
      },
      "OrderItem": {
        "type": "object",
        "required": [
          "productId",
          "name",
          "quantity",
          "unitPrice",
          "subtotal"
        ],
        "properties": {
          "productId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "prod-001",
            "description": "Spasi awal/akhir dihapus; hasilnya harus 1-100 karakter."
          },
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "unitPrice": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "subtotal": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "Order": {
        "type": "object",
        "required": [
          "id",
          "customerName",
          "items",
          "total",
          "status",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ord-"
          },
          "customerName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "status": {
            "type": "string",
            "enum": [
              "pending"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "example": {
          "id": "ord-00000000-0000-4000-8000-000000000001",
          "customerName": "Bambang",
          "items": [
            {
              "productId": "prod-001",
              "name": "Kopi Arabika Gayo",
              "quantity": 2,
              "unitPrice": 85000,
              "subtotal": 170000
            }
          ],
          "total": 170000,
          "status": "pending",
          "createdAt": "2026-10-28T09:00:00.000Z"
        }
      },
      "OrderResponse": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Order"
          }
        }
      },
      "OrderList": {
        "type": "object",
        "required": [
          "service",
          "data"
        ],
        "properties": {
          "service": {
            "type": "string",
            "enum": [
              "order-service"
            ]
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Order"
            }
          }
        }
      },
      "GraphQLRequest": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "example": "query KatalogUMKM { products { id name category price stock seller } }"
          },
          "operationName": {
            "type": "string",
            "nullable": true
          },
          "variables": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true
          },
          "extensions": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true
          }
        }
      },
      "GraphQLResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "message"
              ],
              "properties": {
                "message": {
                  "type": "string"
                },
                "locations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "line": {
                        "type": "integer"
                      },
                      "column": {
                        "type": "integer"
                      }
                    }
                  }
                },
                "path": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "anyOf": [
          {
            "required": [
              "data"
            ]
          },
          {
            "required": [
              "errors"
            ]
          }
        ]
      }
    },
    "responses": {
      "BadRequest": {
        "description": "JSON, parameter, atau nilai input tidak valid.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "qty must be a positive safe integer"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "X-API-Key tidak ada atau salah. Isi key lokal melalui Authorize.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Unauthorized"
            }
          }
        }
      },
      "NotFound": {
        "description": "Produk atau pesanan tidak ditemukan.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Product not found"
            }
          }
        }
      },
      "Conflict": {
        "description": "Stok tidak cukup; batch yang ditolak tidak mengubah stok.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Insufficient stock for prod-001; available: 0"
            }
          }
        }
      },
      "PayloadTooLarge": {
        "description": "Body request melampaui 32 KB.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Request body is too large"
            }
          }
        }
      },
      "RateLimited": {
        "description": "Batas 20 request per 10 detik per IP terlampaui. Tunggu Retry-After.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Terlalu banyak request. Maksimal 20 request per 10 detik per IP."
            }
          }
        },
        "headers": {
          "Retry-After": {
            "description": "Detik hingga request dapat diulangi.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          "RateLimit-Limit": {
            "schema": {
              "type": "integer",
              "example": 20
            }
          },
          "RateLimit-Remaining": {
            "schema": {
              "type": "integer",
              "example": 0
            }
          }
        }
      },
      "BadGateway": {
        "description": "Gateway tidak dapat menghubungi service tujuan, atau data katalog tidak valid.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Service tujuan tidak tersedia"
            }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "Katalog tidak tersedia atau deadline HTTP 2 detik terlampaui; pesanan baru tidak disimpan.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Catalog service is unavailable or timed out"
            }
          }
        }
      },
      "InternalError": {
        "description": "Kesalahan internal service.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Internal server error"
            }
          }
        }
      }
    }
  }
}
