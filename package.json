{
  "name": "prakwebservice-lab09-microservices",
  "version": "0.1.0",
  "private": true,
  "description": "Praktikum Web Service Lab 09–11: microservices, RabbitMQ, dan dokumentasi OpenAPI otomatis",
  "workspaces": [
    "gateway",
    "catalog-service",
    "order-service",
    "notification-service"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "setup:render": "node scripts/setup-render.js",
    "start": "node scripts/start.js",
    "test": "node --test tests/*.test.js",
    "start:monolith": "node monolith/monolith.js",
    "start:notification": "node notification-service/notification-service.js",
    "broker:up": "docker compose up -d --wait rabbitmq",
    "broker:stop": "docker compose stop rabbitmq",
    "broker:down": "docker compose down",
    "test:smoke": "node smoke-test.js",
    "test:lab09": "node scripts/demo-lab09.js",
    "test:lab10": "node scripts/demo-lab10.js",
    "test:lab10:evidence": "node scripts/demo-lab10.js --screenshots",
    "test:lab11": "node scripts/demo-lab11.js",
    "verify:deployment": "node scripts/verify-deployment.js",
    "test:rate-limit": "node scripts/demo-rate-limit.js"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "openapi-to-postmanv2": "^4.18.0",
    "playwright": "^1.62.1"
  }
}
